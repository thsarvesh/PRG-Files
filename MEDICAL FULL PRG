@rowno,10 say '**** Importing Credit Note Account Vouchers  ****' font 'Arial',12
rowno=rowno+1
last4  = last4 + 10
slast5 = slast5 + 10
sele sele(1)
use &datdev\order.&datext alias ord
inde on ordno to ord

Sele Sele(1)
Use &datdev\Pendings.&datext Alias Pendings
Index On ord + Substr(Name,1,20) To Pendings
Sele Sele(1)
Use &datdev\Pend.&datext Alias Pend
Inde On ord+Dtos(ddate)+Str(Final) To Pend

sele sele(1)
use &datdev\gledger.&datext alias gledger
sele sele(1)
use &datatransferpath\tbl_bankcash_adj alia fadj
inde on str(adjfromid)+str(ledid_party)+dtos(adjfromusrdate)+str(adjfromitemno) to fadj

sele sele(1)
use &datatransferpath\tbl_accs alias mled
set filt to betwe(usrdate,firstdate,lastdate) and yearid=year_id and idfrom='GCNTE '
go top
last1=ctod('  /  /    ')
last2='$$$'
last3='%%%%%%%%%'
tf_date=date()
do while ! eof()
	if last1 # mled->usrdate .or. last2 # mled->dr_ledid .or. last3 # mled->unqid
		last4 = last4+4
	endif
	last1 = mled->usrdate
	last2 = mled->dr_ledid
	last3 = mled->unqid
	sele gledger
	append blank
	repl voucher with last4
	repl cd with 'C'
	repl credit with mled->amt
	repl book with 'E'
	repl vcsno with alltr(str(mled->unqid))
	repl date with mled->usrdate
	repl code1 with alltr(str(mled->dr_ledid))
	repl code with alltr(str(mled->cr_ledid))
	repl remark1 with mled->idfrom
	repl remark2 with ' '
    if old_3='Y'
			sele fadj
			seek str(mled->id)+str(mled->cr_ledid)+dtos(mled->usrdate)+str(mled->iditemno)
            do while adjfromid=mled->id and ledid_party=mled->cr_ledid and adjfromusrdate=mled->usrdate and adjfromitemno=mled->iditemno
	l1 = alltrim(str(fadj->adjtousrid))
	l2 = len(l1)
	l3 = l1
	mord=gledger.Code
	mddate=dtos(gledger.Date)
	mfinal=str(-fadj.adjustedamt)
				Sele Pend
				Seek mord+mddate+mfinal
				If !Foun()
					Appe Blank
					Repl ord With gledger.Code
					Repl ddate With gledger.Date
					Repl vcn With l3		
					Repl final With -(fadj.adjustedamt)
					Sele pendings
					Seek pend.ord+subst(pend.vcn,1,20)
					if foun()
						sele Pend
						repl Type With 'A'
						repl voucher With gledger.voucher
						repl adjvoucher With Pendings.voucher
						repl svoucher With Pendings.svoucher
					Endif
				Endi
				Sele fadj
				Skip
			Enddo
endi
***dual******
	sele gledger
	append blank
	repl voucher with last4
	repl cd with 'D'
	repl debit with mled->amt
	repl book with 'E'
	repl vcsno with alltr(str(mled->unqid))
	repl date with mled->usrdate
	repl code with alltr(str(mled->dr_ledid))
	repl code1 with alltr(str(mled->cr_ledid))
	repl remark1 with mled->idfrom
	repl remark2 with ' '
	sele mled
	skip
enddo
close tabl all

