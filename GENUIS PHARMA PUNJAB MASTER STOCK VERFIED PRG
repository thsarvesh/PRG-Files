use &datdev\probat.&datext alias prb   &&probat
index on name+batchno to prb
sele sele(1)                           &&slip no
use &datdev\slipno.&datext alias mslip
go top
last4  = voucher + 10
slast5 = svoucher + 10
last4 = last4 + 20
sele sele(1)
use &datatransferpath\ba_tm alia sal
sele sele(1)
use &datatransferpath\ba_tl alia sld
index on tl_id to sld
sele sal
set filter to betwe(tm_date,firstdate,lastdate)
go top
do whil !eof()
 l3=sal->tm_billno
 =seek(substr(sal->tm_acid,1,12),'ord')
 sele mdis
 appen blan
 repl misc3 with substr(misc3,1,53)+'T'+substr(misc3,55,100)
 repl codep with ord->ordno
 repl voucher with last4
 last4=last4+5
 repl amountp with sal->tm_billamt
 repl final with sal->tm_billamt
 repl round with sal->tm_roff
 if final=0 .and. cash#0
  repl misc3 with substr(misc3,1,34)+'C'+substr(misc3,36,100)
 else
  repl misc3 with substr(misc3,1,34)+'R'+substr(misc3,36,100)
 endif
 repl rout with ''
 repl area with ''
 repl mr with ''
 repl sale with 'Z'
 repl account with 'N'
 repl godwon with 'A'
 repl discafter with 'M'
 do case
****Purchase Bills ****
 case inlist(sal->tm_vrid,14)
  repl type with 'P'
  repl ltype with pcalc
  repl vcn with alltr(str(sal->tm_no))
  repl date with sal->tm_date
  repl lrda with sal->tm_billdt
  repl pm with sal->tm_billno
  ****Sale Bills ****
 case inlist(sal->tm_vrid,11)
  repl type with 'S'
  repl ltype with scalc
  repl vcn with alltr(str(sal->tm_no))
  repl date with sal->tm_date
  repl lrda with sal->tm_billdt
  repl pm with sal->tm_billno
  ****Purchase Return****
 case inlist(sal->tm_vrid,17,16)        
  repl vcn with alltr(str(sal->tm_no))
  repl date with sal->tm_date
  repl lrda with sal->tm_billdt
  repl pm with sal->tm_billno
  repl type with 'B'
  repl ltype with pcalc
 ****Sales Return****
  case inlist(sal->tm_vrid,15)  
  repl type with 'R'
  repl ltype with scalc
  repl vcn with alltr(str(sal->tm_no))
  repl date with sal->tm_date
  repl lrda with sal->tm_billdt
  repl pm with sal->tm_billno
 endcase
****Local Central*****
 isigst=0
 if substr(ord->gstno,1,2)#mstatecode and len(alltrim(ord->gstno))>10
  repl misc3 with substr(misc3,1,64)+'C'+substr(misc3,66)
  isigst=1
 endi
  sele support
 appe blank
 repl type with "#",aliase with "DAT/F-SL",pcode with mdis->voucher,value with mdis->final+mdis->cash
 sele sld
 seek sal->tm_id
 do while tl_id=sal->tm_id .and. !eof()
  last=subs(sld->tl_itemid+spac(20),1,20)
  sele pro
  seek last
  sele dis
  appen blan
  repl codep with mdis->codep
  repl vcn with iif(empty(mdis->vcn),mdis->challan,mdis->vcn)
  repl date with iif(empty(mdis->date),mdis->chdate,mdis->date)
  repl voucher with mdis->voucher
  repl code with pro->code
  repl batch with sld->tl_b_cf1&&tl_batch
  repl exp with sld->tl_b_df1&&bdate
  repl pack with 1
  repl rate with sld->tl_rate
  repl qty with sld->tl_qty
  if qty=0 and rate=0 and sld->tl_amount#0
  repl qty with 1
  repl rate with sld->tl_amount
  endi
  repl free with 0
*  repl disc1 with sld->tl_d1p
 * repl disc2 with sld->tl_d2p
  repl svdis with sld->tl_namt_f1
  repl misc4 with subs(misc4,1,43)+'L'+subs(misc4,45)
  repl rout with ''
  repl area with ''
  repl flg with iif(mdis->type='S','G',mdis->type)
*  repl mrp with 0
if isigst=1
   repl ssta with sld->tl_nper_f2
   else 
   repl ssta with sld->tl_nper_f3
   if empty(ssta) and sld->tl_nper_f2#0
   repl ssta with sld->tl_nper_f2/2
   endi
   repl cgst with ssta
   
endi
  repl half with 'A'
  repl godwon with mdis->godwon
  sele sld
  skip
endd
sele sal
skip
endd
