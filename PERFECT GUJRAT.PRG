@rowno,10 say '**** Importing Product/HSN ****' font 'Arial',10
rowno=rowno+1
sele sele(1)
use &datatransferpath\item_master alias fitm
sele sele(1)
use &datdev\saletype.&datext alias mpcm
index on sgcode+sname+str(igst,5,2) to mpcm
sele sele(1)
use &datdev\pro.&datext alias  mitm
dele all
sele fitm
scan
	sele mitm
	appen blank
	repl code with fitm.no
	repl name with alltri(str(fitm.no))
	repl product with upper(fitm.item_name)
	repl packing with ''
	repl billname with upper(fitm.item_name)
	repl pack with 0
	repl rackno with fitm.hsn_no
	repl unit with upper(fitm.packing)
	repl mitm.decimal with 'Y'
	repl mitm.salfix with 'N'
	repl mitm.gcode with padr(fitm.itemgroup,6)
	repl mitm.minimum with fitm.mini
	repl mitm.maximum with fitm.maxi
	repl mitm.halfsche with 'A'
	repl mitm.qtrsche with 'Y'
	repl mitm.salsc with 0
	repl mitm.mrp with fitm.mrp
	repl mitm.ratea with fitm.rate
	repl mitm.lprate with fitm.purch_rate
	repl mitm.prate with fitm.purch_rate
	repl saltax with fitm.igst/2
	repl cgst   with fitm.igst/2
	repl igst   with fitm.igst
	mhsn=fitm.chhd
	&&&HSN and Tax Mast
	sele mpcm
	seek 'COMMCD' + substr(mhsn+space(40),1,40) + str(mitm.igst,5,2)
	if !found()
		append blank
		repl mpcm.sgcode with 'COMMCD',;
			mpcm.scode  with 'HH'+alltrim(str(recno())),;
			mpcm.sname  with mhsn,;
			mpcm.parnam with mhsn,;
			mpcm.tax with mitm.saltax,;
			mpcm.cgst with mitm.cgst,;
			mpcm.igst with mitm.igst,;
			mpcm.tcode with 'No'
	endif
	repl mitm.gcode6 with mpcm.scode
endscan
close table all
