@rowno,10 say '**** Importing Batch ****' font 'Arial',10
rowno=rowno+1
sele sele(1)
use &datatransferpath\item_master alias fsbal
sele sele(1)
use &datdev\pro.&datext alias mitm
index on str(code,9) to mitm
sele sele(1)
use &datdev\probat.&datext alias msbal
index on str(code,9)+batchno to msbal
sele fsbal
go top
scan
	sele mitm
	seek str(fsbal.no,9)
	sele msbal
	seek str(fsbal.no,9)+str(fsbal.mrp,9,2)
	if !found()
		append blank
		repl msbal.code with mitm.code,;
			msbal.name with mitm.name,;
			msbal.billname with mitm.billname,;
			msbal.product with mitm.product,;
			msbal.pack with mitm.pack,;
			msbal.unit2 with mitm.unit2,;
			msbal.unit with mitm.unit,;
			msbal.decimal with 'Y',;
			msbal.opening with fsbal.closingqty,;
			msbal.balance with fsbal.closingqty,;
			msbal.o_a with fsbal.closingqty,;
			msbal.b_a with fsbal.closingqty,;
			msbal.batchno with str(fsbal.mrp,9,2)
		repl msbal.exp with ctod(''),;
			msbal.mrp with fsbal.mrp,;
			msbal.prate with fsbal.purch_rate,;
			msbal.ratea with fsbal.rate,;
			msbal.lprate with fsbal.purch_rate,;
			msbal.misc1 with mitm.gcode,;
			msbal.supcode with ''
	else
		repl msbal.opening with msbal.opening + fsbal.closingqty,;
			msbal.balance with msbal.balance + fsbal.closingqty,;
			msbal.o_a with msbal.o_a + fsbal.closingqty,;
			msbal.b_a with msbal.b_a + fsbal.closingqty
	endif
endscan
sele msbal
close table all
