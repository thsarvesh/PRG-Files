@rowno,10 say '**** Importing Product/HSN ****' font 'Arial',10
rowno=rowno+1
sele sele(1)
use &datatransferpath\itmaster alias fitm
sele sele(1)
use &datatransferpath\gstslab alias ftax
index on taxcode to ftax
sele sele(1)
use &datdev\saletype.&datext alias mpcm
index on sgcode+sname+str(igst,5,2) to mpcm
sele sele(1)
use &datdev\pro.&datext alias  mitm
dele all
sele fitm
scan
	=seek(taxcode,'ftax')
	sele mitm
	appen blank
	repl code with fitm.itcode
	repl name with alltri(str(fitm.itcode))
	repl product with chrtran(fitm.itname,chr(0),'')
	repl billname with chrtran(fitm.itname,chr(0),'')
	repl rackno with fitm.barcode
	repl unit with 'PCS'
	repl mitm.decimal with 'Y'
	repl mitm.salfix with 'N'
	repl mitm.gcode with padr(fitm.itgcode,6)
	repl mitm.gcode3 with padr(fitm.itsubgcode,6)
	repl mitm.gcode5 with padr(fitm.deptcode,6)
	repl mitm.halfsche with 'A'
	repl mitm.qtrsche with 'Y'
	repl mitm.salsc with 0
	repl mitm.mrp with fitm.mrp
	repl mitm.ratea with fitm.salerate
	repl mitm.rateb with fitm.fixwhrate
	repl mitm.lprate with fitm.purrate
	repl mitm.prate with fitm.purrate
	repl saltax with ftax.cgstper
	repl cgst   with ftax.sgstper
	repl igst   with ftax.igstper
	mhsn=fitm.hsncode
	&&&HSN and Tax Mast
	sele mpcm
	seek 'COMMCD' + substr(mhsn+space(40),1,40) + str(mitm.igst,5,2)
	if !found()
		append blank
		repl mpcm.sgcode with 'COMMCD',;
			mpcm.scode  with 'HH'+alltrim(str(recno())),;
			mpcm.sname  with mhsn,;
			mpcm.parnam with mhsn,;
			mpcm.tax with mitm.saltax,;
			mpcm.cgst with mitm.cgst,;
			mpcm.igst with mitm.igst,;
			mpcm.tcode with 'No'
	endif
	repl mitm.gcode6 with mpcm.scode
endscan
close table all
